# Production build settings (public - no secrets here). Used by `npm run build`
# and the Boxity deploy workflow.

# The game's id on Boxity. Hosted on Boxity Legion, the client always joins
# through the matchmaker at play.bloxity.io (Legion.SDK.net.resolveEndpoint),
# never <id>.host.bloxity.io.
VITE_BOXITY_HOSTING_ID=1-speed-jetpack-escape

# Slug the game is registered under on bloxity.io (Gems purchases, login).
VITE_GAME_SLUG=1-speed-jetpack-escape

# Players per room. Must equal the server's MAX_CLIENTS and the deploy's seatCap.
VITE_ROOM_SIZE=8

VITE_BLOXITY_PORTAL_URL=https://bloxity.io
VITE_BLOXITY_API_URL=https://api.bloxity.io
