# Local development settings. Copy this file to `.env` (or `.env.local`).
# Production builds use .env.production instead.

# The game slug on bloxity.io.
VITE_GAME_SLUG=1-speed-jetpack-escape

# Bloxity endpoints. Leave these as-is unless you are running the portal locally.
# They MUST be set: without them the SDK repoints itself at localhost when it
# detects a dev server, and the login popup can never return a token.
VITE_BLOXITY_PORTAL_URL=https://bloxity.io
VITE_BLOXITY_API_URL=https://api.bloxity.io

# Colyseus game server. Leave unset to use http://<this host>:2567 in dev and
# the page's own origin in production (when the server serves the built client).
# VITE_SERVER_URL=http://localhost:2567

# Play against the Boxity-hosted backend instead of your own server: joins go
# through the matchmaker. From your own domain or localhost that reaches prod,
# unless the version is "preview" (dev channel).
# VITE_BOXITY_HOSTING_ID=1-speed-jetpack-escape
# VITE_BOXITY_HOSTING_VERSION=preview

# Players per room; must match the server's MAX_CLIENTS.
# VITE_ROOM_SIZE=8
