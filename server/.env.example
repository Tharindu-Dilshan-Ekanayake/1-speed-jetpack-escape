# Copy to server/.env for local development. On Boxity hosting, Legion injects
# PORT, NODE_ENV, CLIENT_ORIGIN, JWT_SECRET, MONGODB_URI, BLOXITY_GAME_ID,
# BLOXITY_CHANNEL and POD_NAME by itself - don't hardcode them.

# Port for Colyseus + the HTTP API. The client dev build expects 2567.
PORT=2567

# Boxity game id (hosting id). Used to verify login tokens and report stats.
BLOXITY_GAME_ID=1-speed-jetpack-escape
# Only if the bloxity.io store slug differs from the game id; webhooks for
# another slug are then refused.
# BLOXITY_GAME_SLUG=
BLOXITY_API_URL=https://api.bloxity.io

# Shared secret Boxity sends as x-legion-webhook-secret on Gems purchase
# webhooks. Webhooks are rejected (and refunded) while this is empty.
LEGION_WEBHOOK_SECRET=

# Leave empty locally to save player data as JSON files in server/data (one
# process only). Set it to share data between several processes, e.g.
# mongodb://127.0.0.1:27017/jetpack-escape
# MONGODB_URI=
# DATA_DIR=./data

# Players per room. Must equal the client's VITE_ROOM_SIZE and the deploy's seatCap.
# MAX_CLIENTS=8

# Your game site's origin, plus any extra allowed browser origins for /api.
# CLIENT_ORIGIN=
ALLOWED_ORIGINS=

# LOCAL TESTING ONLY: makes every Gems product free. Never enable in production.
# DEV_PURCHASES=1
